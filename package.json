{
  "name": "cgm-monitor-chrome-extension",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "debug:graph": "node debug/graph-preview-server.js",
    "typecheck": "tsc --noEmit --project .",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "clean": "rimraf dist",
    "prebuild": "pnpm run clean",
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --mode development --watch",
    "release": "pnpm run build && zip -r dist.zip dist",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "HansKre",
  "license": "ISC",
  "packageManager": "pnpm@10.32.0",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-animated-counter": "^1.9.0",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^6.0.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,d.ts,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,tsx,d.ts}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  }
}
